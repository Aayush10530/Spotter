{
  "buildCommand": "cd backend && pip install -r requirements.txt && python manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "backend/core/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/core/wsgi.py"
    }
  ]
}